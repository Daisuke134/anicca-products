{
  "openapi": "3.1.0",
  "info": {
    "title": "Anicca x402 API",
    "version": "1.0.0",
    "description": "Pay-per-call JSON endpoints by Anicca. $0.005 USDC on Base per call, x402 exact scheme, PayAI facilitator.",
    "x-guidance": "GET /.netlify/functions/x402-affirm?topic=calm&lang=en returns one affirmation (topics: calm, confidence, selflove, impermanence; lang ja|en). GET /.netlify/functions/x402-capafy-skill?id=<Capafy agent id> returns details and a buy link for an Anicca Capafy AI skill (ids at https://capafy.ai/publisher/Anicca). GET /.netlify/functions/x402-maritime-nudge?goal=sleep&lang=en returns a behavior-change nudge plus a 3-step habit plan (goal: sleep|exercise|focus|phone|stress). GET /.netlify/functions/x402-naive-reflect?mood=anxious&lang=en returns a reflection prompt plus a 2-minute exercise (mood: anxious|low|angry|scattered|grateful). Call without payment to get the 402 challenge, then retry with the x402 v2 PAYMENT-SIGNATURE header (legacy v1 X-PAYMENT is also accepted).",
    "contact": {
      "name": "Anicca",
      "url": "https://aniccaai.com/dais"
    }
  },
  "servers": [
    {
      "url": "https://aniccaai.com"
    }
  ],
  "paths": {
    "/.netlify/functions/x402-affirm": {
      "get": {
        "operationId": "getAffirmation",
        "summary": "Anicca affirmation (ja/en) as JSON",
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.005"
          },
          "protocols": [
            {
              "x402": {}
            }
          ]
        },
        "parameters": [
          {
            "name": "topic",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "calm",
                "confidence",
                "selflove",
                "impermanence"
              ]
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ja",
                "en"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paid result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "affirmation": {
                      "type": "string"
                    },
                    "topic": {
                      "type": "string"
                    },
                    "lang": {
                      "type": "string"
                    },
                    "source": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "affirmation",
                    "topic",
                    "lang",
                    "source"
                  ]
                }
              }
            }
          },
          "402": {
            "description": "Payment Required (x402 v1, exact, Base USDC, PayAI facilitator)"
          }
        }
      }
    },
    "/.netlify/functions/x402-capafy-skill": {
      "get": {
        "operationId": "getCapafySkill",
        "summary": "Capafy AI skill details (Anicca publisher) with tracked buy link",
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.005"
          },
          "protocols": [
            {
              "x402": {}
            }
          ]
        },
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{6,20}$",
              "example": "6839055303"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paid result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "tags": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "model": {
                      "type": "string"
                    },
                    "agentType": {
                      "type": "string"
                    },
                    "estimatedExecutionMinutes": {
                      "type": "number"
                    },
                    "pricing": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "rating": {
                      "type": "number"
                    },
                    "salesVolume": {
                      "type": "number"
                    },
                    "url": {
                      "type": "string"
                    },
                    "buy_link": {
                      "type": "string"
                    },
                    "source": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "description",
                    "url",
                    "buy_link",
                    "source"
                  ]
                }
              }
            }
          },
          "402": {
            "description": "Payment Required (x402 v1, exact, Base USDC, PayAI facilitator)"
          }
        }
      }
    },
    "/.netlify/functions/x402-maritime-nudge": {
      "get": {
        "operationId": "getMaritimeNudge",
        "summary": "Maritime agent: behavior-change nudge + 3-step habit plan ($0.005)",
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.005"
          },
          "protocols": [
            {
              "x402": {}
            }
          ]
        },
        "parameters": [
          {
            "name": "goal",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "sleep",
                "exercise",
                "focus",
                "phone",
                "stress"
              ]
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "ja"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paid result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "goal": {
                      "type": "string"
                    },
                    "lang": {
                      "type": "string"
                    },
                    "nudge": {
                      "type": "string"
                    },
                    "plan": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "agent": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "goal",
                    "lang",
                    "nudge",
                    "plan",
                    "agent"
                  ]
                }
              }
            }
          },
          "402": {
            "description": "Payment Required (x402 v2, exact, Base USDC, PayAI facilitator)"
          }
        }
      }
    },
    "/.netlify/functions/x402-naive-reflect": {
      "get": {
        "operationId": "getNaiveReflection",
        "summary": "Naive agent: reflection prompt + 2-minute exercise ($0.005)",
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.005"
          },
          "protocols": [
            {
              "x402": {}
            }
          ]
        },
        "parameters": [
          {
            "name": "mood",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "anxious",
                "low",
                "angry",
                "scattered",
                "grateful"
              ]
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "ja"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paid result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mood": {
                      "type": "string"
                    },
                    "lang": {
                      "type": "string"
                    },
                    "prompt": {
                      "type": "string"
                    },
                    "exercise": {
                      "type": "string"
                    },
                    "agent": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "mood",
                    "lang",
                    "prompt",
                    "exercise",
                    "agent"
                  ]
                }
              }
            }
          },
          "402": {
            "description": "Payment Required (x402 v2, exact, Base USDC, PayAI facilitator)"
          }
        }
      }
    }
  }
}
