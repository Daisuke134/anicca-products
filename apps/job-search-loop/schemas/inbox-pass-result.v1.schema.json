{
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "processed_threads", "calendar_events", "replies", "assessments", "reports"],
  "properties": {
    "status": {"type": "string"},
    "processed_threads": {"type": "integer"},
    "calendar_events": {"type": "array", "items": {"type": "string"}},
    "replies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message_id", "status"],
        "properties": {
          "message_id": {"type": "string"},
          "status": {
            "enum": ["sent", "blocked", "route_scheduling", "delivery_unknown"]
          }
        }
      }
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assessment_id", "route", "state"],
        "properties": {
          "assessment_id": {"type": "string"},
          "route": {
            "enum": ["autonomous_allowed", "manual_integrity_gate"]
          },
          "state": {
            "enum": [
              "detected",
              "policy_blocked",
              "prepared",
              "executing",
              "execution_failed",
              "verified",
              "submit_claimed",
              "submit_started",
              "submitted",
              "submit_unknown"
            ]
          }
        }
      }
    },
    "reports": {"type": "array", "items": {"type": "string"}}
  }
}
